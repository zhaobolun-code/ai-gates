{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/check-hooks-drift.ps1",
        "failClosed": false,
        "timeout": 15
      }
    ],
    "beforeShellExecution": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/git-safety-check.ps1",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/pre-write-gate.ps1",
        "matcher": "Write|StrReplace|EditNotebook",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/post-write-gate.ps1",
        "matcher": "Write|StrReplace|EditNotebook",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "afterAgentResponse": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/mark-pm-gate.ps1",
        "matcher": "AgentResponse",
        "failClosed": false,
        "timeout": 10
      }
    ]
  }
}
