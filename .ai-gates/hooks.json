{
  "version": 1,
  "hooks": {
    "preCompact": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/relight-after-compact.ps1",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "sessionStart": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/check-hooks-drift.ps1",
        "failClosed": false,
        "timeout": 15
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/inject-turn-tokens.ps1",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/pre-shell-gate.ps1",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/pre-write-gate.ps1",
        "matcher": "Write|StrReplace|EditNotebook",
        "failClosed": false,
        "timeout": 10
      },
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/task-model-gate.ps1",
        "matcher": "Task|CallDynamicTool",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/post-write-gate.ps1",
        "matcher": "Write|StrReplace|EditNotebook",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "afterAgentResponse": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/mark-pm-gate.ps1",
        "matcher": "AgentResponse",
        "failClosed": false,
        "timeout": 10
      }
    ]
  }
}
