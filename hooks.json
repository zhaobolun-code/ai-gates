{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/git-safety-check.ps1",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/audit-write.ps1",
        "matcher": "Write|StrReplace|EditNotebook",
        "failClosed": false,
        "timeout": 10
      },
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/pm-gate-check.ps1",
        "matcher": "Write|StrReplace|EditNotebook",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "afterAgentResponse": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/mark-pm-gate.ps1",
        "matcher": "AgentResponse",
        "failClosed": false,
        "timeout": 10
      }
    ]
  }
}
